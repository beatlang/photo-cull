{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "build-app",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "build",
                                   "${workspaceFolder}/src/PCull.App/PCull.App.csproj",
                                   "-p:Platform=x64"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
                  {
                      "label":  "Run app (Release, no debugger)",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "run",
                                   "--project",
                                   "${workspaceFolder}/src/PCull.App/PCull.App.csproj",
                                   "--configuration",
                                   "Release",
                                   "-p:Platform=x64"
                               ],
                      "problemMatcher":  "$msCompile"
                  },
                  {
                      "label":  "test",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "test",
                                   "${workspaceFolder}/tests/PCull.Tests"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  "test"
                  }
              ]
}
