{
    "version":  "2.0.0",
    "tasks":  [
                  {
                      "label":  "build-app",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "build",
                                   "${workspaceFolder}/src/PhotoCull.App/PhotoCull.App.csproj",
                                   "-p:Platform=x64"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  {
                                    "kind":  "build",
                                    "isDefault":  true
                                }
                  },
                  {
                      "label":  "test",
                      "type":  "process",
                      "command":  "dotnet",
                      "args":  [
                                   "test",
                                   "${workspaceFolder}/tests/PhotoCull.Tests"
                               ],
                      "problemMatcher":  "$msCompile",
                      "group":  "test"
                  }
              ]
}
