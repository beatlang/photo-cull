{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "pCull.App (x64)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-app",
      "program": "${workspaceFolder}/src/PCull.App/bin/x64/Debug/net10.0-windows10.0.19041.0/PCull.App.exe",
      "cwd": "${workspaceFolder}/src/PCull.App",
      "console": "internalConsole",
      "stopAtEntry": false
    },
    {
      "name": "pCull.App (Release, no debugger)",
      "type": "node-terminal",
      "request": "launch",
      "command": "dotnet run --project src/PCull.App/PCull.App.csproj --configuration Release -p:Platform=x64",
      "cwd": "${workspaceFolder}"
    }
  ]
}
