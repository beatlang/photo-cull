<Window
    x:Class="PhotoCull.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PhotoCull.App"
    Title="PhotoCull">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Padding="8" Spacing="8">
            <Button x:Name="PickFolderBtn" Content="Pick Folder..." />
            <Button x:Name="RunScanBtn" Content="Run Scan" />
            <Button x:Name="CancelBtn" Content="Cancel" />
            <ProgressBar x:Name="ProgressBar" Width="200" Height="14" Minimum="0" Maximum="100"/>
            <ToggleButton x:Name="CompareToggle" Content="Compare"/>
            <Button x:Name="DeleteBtn" Content="Delete marked" HorizontalAlignment="Right"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" x:Name="SetsList" ItemsSource="{Binding Sets}" SelectedItem="{Binding SelectedSet, Mode=TwoWay}" DisplayMemberPath="Name" />

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="MainImage" Stretch="Uniform" />
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Padding="8" Spacing="8">
                    <Button x:Name="KeepBtn" Content="Keep" />
                    <Button x:Name="ReviewBtn" Content="Review" />
                    <Button x:Name="MarkDeleteBtn" Content="Delete" />
                    <Button x:Name="FavBtn" Content="Favorite" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Column="2" Padding="8" Spacing="8">
                <TextBlock x:Name="InfoText" Text="File info" TextWrapping="Wrap"/>

                <TextBlock Text="Quality scores:" FontWeight="SemiBold"/>
                <TextBlock x:Name="ScoresText" Text="-"/>

                <TextBlock Text="Histograms:" FontWeight="SemiBold"/>
                <Border BorderBrush="Gray" BorderThickness="1" Padding="4">
                    <StackPanel>
                        <Rectangle x:Name="RHist" Height="10" Fill="Red" Width="10"/>
                        <Rectangle x:Name="GHist" Height="10" Fill="Green" Width="10"/>
                        <Rectangle x:Name="BHist" Height="10" Fill="Blue" Width="10"/>
                        <Rectangle x:Name="LHist" Height="10" Fill="Gray" Width="10"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Compare overlay -->
            <Grid x:Name="CompareGrid" Visibility="Collapsed" Background="#80000000">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ScrollViewer x:Name="CompareLeft" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="CompareLeftImage" Stretch="Uniform" />
                </ScrollViewer>
                <ScrollViewer x:Name="CompareRight" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Image x:Name="CompareRightImage" Stretch="Uniform" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>